# ==============================================================================
# EduSense AI Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=production
PROJECT_NAME="EduSense AI"
VERSION=1.0.0
DEBUG=false
SECRET_KEY=change_this_super_secret_key_in_production

# CORS Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:80

# Database Configuration
# SQLite Development: sqlite:///./edusense.db
# PostgreSQL Production: postgresql://user:password@db_host:5432/edusense_db
DATABASE_URL=postgresql://edusense_user:secure_password@localhost:5432/edusense_db

# Firebase Authentication
FIREBASE_PROJECT_ID=edusense-ai-prod
FIREBASE_CREDENTIALS_FILE=./firebase-service-account.json
DEV_AUTH_ENABLED=false

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ChromaDB Vector Store
CHROMADB_COLLECTION=edusense_documents
CHROMADB_PERSIST_DIR=./chroma_data

# Rate Limiting & Security
RATE_LIMIT_PER_MINUTE=100
MAX_REQUEST_SIZE_BYTES=10485760
